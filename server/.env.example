NODE_ENV=development
APP_DEBUG=false

# HTTP server and allowed browser origin.
PORT=5000
CLIENT_URL=http://localhost:3000

# Prisma uses DATABASE_URL. server/src/config.ts also reads DATABASE_URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/estatehub?schema=public

# Replace these placeholders with long, distinct random secrets.
JWT_ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-token-secret

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Replace the sample contact with a real monitored address before deployment.
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=EstateHub/1.0 (contact: legal@estatehub.example)

# Optional: set SEED_PASSWORD locally (at least 12 characters) before prisma:seed.
# The password is hashed; no OAuth tokens or real signatures are seeded.

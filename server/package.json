{
    "name": "server",
    "version": "1.0.0",
    "description": "",
    "license": "ISC",
    "author": "",
    "main": "index.js",
    "scripts": {
        "build": "rimraf dist && npx tsc",
        "test": "npm run build && node --test tests/*.test.cjs",
        "start": "npm run build && node dist/src/index.js",
        "dev": "npm run build && concurrently \"npx tsc -w\" \"nodemon --exec ts-node src/index.ts\"",
        "prisma:generate": "prisma generate",
        "postprisma:generate": "shx cp -r node_modules/.prisma/client/index.d.ts ../client/src/types/prisma.d.ts",
        "prisma:migrate": "prisma migrate dev --skip-seed",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:status": "prisma migrate status",
        "prisma:migrate:reset": "prisma migrate reset --skip-seed",
        "prisma:seed": "prisma db seed",
        "prisma:studio": "prisma studio",
        "prisma:validate": "prisma validate"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "@terraformer/wkt": "^2.2.2",
        "axios": "^1.20.0",
        "bcryptjs": "^3.0.3",
        "body-parser": "^2.3.0",
        "cloudinary": "^2.11.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.12.1",
        "multer": "^2.4.0",
        "prisma": "^6.19.3",
        "uuid": "^11.1.1"
    },
    "overrides": {
        "diff": "4.0.4",
        "path-to-regexp": "8.4.2",
        "picomatch": "2.3.2"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^24.13.6",
        "@types/terraformer__wkt": "^2.0.3",
        "@types/uuid": "^10.0.0",
        "concurrently": "^9.2.4",
        "nodemon": "^3.1.14",
        "prettier-plugin-prisma": "^5.0.0",
        "rimraf": "^6.1.3",
        "shx": "^0.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}

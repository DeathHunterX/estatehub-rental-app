generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, unaccent]
}

enum Highlight {
  HighSpeedInternetAccess
  WasherDryer
  AirConditioning
  Heating
  SmokeFree
  CableReady
  SatelliteTV
  DoubleVanities
  TubShower
  Intercom
  SprinklerSystem
  RecentlyRenovated
  CloseToTransit
  GreatView
  QuietNeighborhood
}

enum Amenity {
  WasherDryer
  AirConditioning
  Dishwasher
  HighSpeedInternet
  HardwoodFloors
  WalkInClosets
  Microwave
  Refrigerator
  Pool
  Gym
  Parking
  PetsAllowed
  WiFi
}

enum PropertyType {
  Rooms
  Tinyhouse
  Apartment
  Villa
  Townhouse
  Cottage
}

enum ApplicationStatus {
  Pending
  Denied
  Approved
  Paid
  Withdrawn
}

enum PropertyListingStatus {
  Free
  Closed
}

enum SettlementMethod {
  Cash
  BankTransfer
}

enum RenewalStatus {
  Requested
  Approved
  Denied
}

enum PaymentStatus {
  Pending
  Paid
  PartiallyPaid
  Overdue
}

enum UserRole {
  Tenant
  Manager
}

enum ProviderType {
  Credentials
  Google
  Facebook
}

model User {
  id          String        @id @default(uuid())
  name        String  
  email       String        @unique
  phoneNumber String?
  role        UserRole
  createdAt   DateTime      @default(now())

  accounts    Account[]
  manager     Manager?
  tenant      Tenant?
  messages    Message[]
  notifications Notification[]
}

model Account {
  id                   String   @id @default(uuid())
  userId               String
  provider             ProviderType
  providerAccountId    String
  passwordHash         String?
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Property {
  id                Int          @id @default(autoincrement())
  name              String
  description       String
  pricePerMonth     Float
  securityDeposit   Float
  applicationFee    Float
  photoUrls         String[]
  amenities         Amenity[]
  highlights        Highlight[]
  isPetsAllowed     Boolean      @default(false)
  isParkingIncluded Boolean      @default(false)
  beds              Int
  baths             Float
  squareFeet        Int
  propertyType      PropertyType
  postedDate        DateTime     @default(now())
  averageRating     Float?       @default(0)
  numberOfReviews   Int?         @default(0)
  locationId        Int
  managerUserId  String
  listingStatus PropertyListingStatus @default(Free)
  closedAt DateTime?
  archivedAt DateTime?

  location     Location      @relation(fields: [locationId], references: [id])
  manager      Manager       @relation(fields: [managerUserId], references: [userId])
  leases       Lease[]
  applications Application[]
  favoritedBy  Tenant[]      @relation("TenantFavorites")
  tenants      Tenant[]      @relation("TenantProperties")
}

model Manager {
  id          Int    @id @default(autoincrement())
  userId   String @unique
  

  managedProperties Property[]
  chats             Chat[]
  signingProfile    ManagerSigningProfile?

  user User @relation(fields: [userId], references: [id])
}

model ManagerSigningProfile {
  managerUserId       String   @id
  legalName           String
  title               String   @default("")
  agreementNotes      String   @default("")
  signatureCiphertext String?
  signatureSalt       String?
  signatureIv         String?
  signatureUpdatedAt  DateTime?
  acceptedPrivacyAt   DateTime?
  acceptedSharingAt   DateTime?
  acceptedPolicyVersion String?
  updatedAt           DateTime @updatedAt

  manager Manager @relation(fields: [managerUserId], references: [userId], onDelete: Cascade)
}

model Tenant {
  id          Int    @id @default(autoincrement())
  userId   String @unique
  

  properties   Property[]    @relation("TenantProperties")
  favorites    Property[]    @relation("TenantFavorites")
  applications Application[]
  leases       Lease[]
  chats        Chat[]

  user User @relation(fields: [userId], references: [id])
}

model Location {
  id          Int                                   @id @default(autoincrement())
  address     String
  subdistrict String?
  district    String?
  city        String
  state       String
  country     String
  postalCode  String
  coordinates Unsupported("geography(Point, 4326)")

  properties Property[]
}

model Application {
  id              Int               @id @default(autoincrement())
  applicationDate DateTime
  status          ApplicationStatus
  propertyId      Int
  tenantUserId    String
  name            String
  email           String
  phoneNumber     String
  message         String?
  leaseId         Int?              @unique
  originalMonthlyRent Float?
  originalDeposit Float?
  agreedMonthlyRent Float?
  settlementMethod SettlementMethod?
  tenantConfirmedAt DateTime?
  managerConfirmedAt DateTime?
  transferReference String?
  paidAt DateTime?
  approvedAt DateTime?
  paymentDueAt DateTime?
  cancellationRequestedAt DateTime?
  cancellationExecuteAt DateTime?
  cancellationReason String?
  denialReason String?
  paymentDisputedAt DateTime?
  paymentDisputeResolvedAt DateTime?
  paymentDisputeReason String?

  property Property @relation(fields: [propertyId], references: [id])
  tenant   Tenant   @relation(fields: [tenantUserId], references: [userId])
  lease    Lease?   @relation(fields: [leaseId], references: [id])

  @@index([status, paymentDueAt])
  @@index([status, cancellationExecuteAt])
}

model Lease {
  id              Int      @id @default(autoincrement())
  startDate       DateTime
  endDate         DateTime
  rent            Float
  deposit         Float
  propertyId      Int
  tenantUserId String
  renewalStatus RenewalStatus?
  renewalRequestedAt DateTime?
  renewalReviewedAt DateTime?
  renewalMonths Int?

  property    Property     @relation(fields: [propertyId], references: [id])
  tenant      Tenant       @relation(fields: [tenantUserId], references: [userId])
  application Application?
  payments    Payment[]
}

model Payment {
  id            Int           @id @default(autoincrement())
  amountDue     Float
  amountPaid    Float
  dueDate       DateTime
  paymentDate   DateTime
  paymentStatus PaymentStatus
  leaseId       Int

  lease Lease @relation(fields: [leaseId], references: [id])
}

model Chat {
  id                Int      @id @default(autoincrement())
  tenantUserId      String
  managerUserId     String
  createdAt         DateTime @default(now())
  tenantLastReadAt  DateTime?
  managerLastReadAt DateTime?
  lastMessageId     Int?      @unique

  tenant      Tenant   @relation(fields: [tenantUserId], references: [userId])
  manager     Manager  @relation(fields: [managerUserId], references: [userId])
  messages    Message[]
  lastMessage Message? @relation("LastMessage", fields: [lastMessageId], references: [id])
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int
  senderId  String   // references User.id
  content   String
  createdAt DateTime @default(now())

  chat        Chat @relation(fields: [chatId], references: [id])
  sender      User @relation(fields: [senderId], references: [id])
  lastMessage Chat? @relation("LastMessage")
}

model Notification {
  id Int @id @default(autoincrement())
  userId String
  kind String
  title String
  body String
  resourceId Int?
  readAt DateTime?
  createdAt DateTime @default(now())
  emailSentAt DateTime?
  emailAttempts Int @default(0)
  dedupeKey String? @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
